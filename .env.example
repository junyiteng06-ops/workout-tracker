# 本番のURL(サイトマップ・canonical・OGPに使用)
PUBLIC_SITE_URL=https://example.com

# Google AdSense のパブリッシャーID(例: ca-pub-1234567890123456)。空なら広告枠はプレースホルダ表示
PUBLIC_ADSENSE_CLIENT=

# Amazonアソシエイトのトラッキングタグ(例: yoursite-22)。空ならタグなしの通常リンク
PUBLIC_AMAZON_TAG=

# 楽天アフィリエイトID(例: 1a2b3c4d.5e6f7g8h.1a2b3c4e.5e6f7g8i)。空なら通常リンク
PUBLIC_RAKUTEN_AFFILIATE_ID=
