---
import AdSlot from '@/components/ads/AdSlot.astro';
import ArticleGrid from '@/components/ArticleGrid.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { CATEGORIES } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveCategories, getPublishedArticles } from '@/lib/articles';
import { breadcrumbJsonLd } from '@/lib/seo';

const articles = await getPublishedArticles();
const activeCategories = await getActiveCategories();
const crumbs = [{ label: 'コラム' }];
---

<BaseLayout
  title="筋トレコラム一覧"
  description="トレーニングのフォーム解説、栄養・食事、器具レビュー、筋トレの基礎知識など、筋トレに役立つコラムの一覧です。"
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1>コラム一覧</h1>
    <ul class="categories">
      {
        activeCategories.map((key) => (
          <li>
            <a href={`/articles/category/${key}`}>{CATEGORIES[key].label}</a>
          </li>
        ))
      }
    </ul>
    <ArticleGrid articles={articles} />
    <AdSlot position="list-inline" />
  </div>
</BaseLayout>

<style>
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .categories a {
    display: inline-block;
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .categories a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
