---
import Alert from '@/components/Alert.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { authErrorMessage } from '@/lib/authErrors';
import { formString } from '@/lib/http';

export const prerender = false;

let error = '';
let sent = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = formString(form, 'email');
  const { error: authError } = await Astro.locals.supabase.auth.resetPasswordForEmail(email, {
    redirectTo: `${Astro.url.origin}/auth/callback?next=${encodeURIComponent('/app/settings?reset=1')}`,
  });
  // 登録の有無を推測されないよう、レート制限以外は常に「送信しました」と表示する
  if (authError?.code?.startsWith('over_')) error = authErrorMessage(authError);
  else sent = true;
}
---

<AuthLayout title="パスワードの再設定">
  {
    sent ? (
      <Alert type="success" message="ご登録のメールアドレス宛に、パスワード再設定用のリンクを送信しました。" />
    ) : (
      <>
        <Alert type="error" message={error} />
        <p class="auth__note">登録したメールアドレスを入力してください。パスワード再設定用のリンクをお送りします。</p>
        <form method="post">
          <label>
            メールアドレス
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <button class="btn" type="submit">再設定リンクを送る</button>
        </form>
      </>
    )
  }
  <div class="auth__links">
    <p><a href="/login">ログインに戻る</a></p>
  </div>
</AuthLayout>
