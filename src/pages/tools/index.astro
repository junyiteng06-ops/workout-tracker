---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '@/lib/seo';

const crumbs = [{ label: 'ツール' }];
const tools = [
  {
    href: '/tools/1rm',
    title: '1RM計算ツール',
    description: '重量と回数から最大挙上重量を推定。回数別の重量の目安も一覧で表示します。',
  },
];
---

<BaseLayout
  title="筋トレ計算ツール一覧"
  description="1RM計算など、筋トレの重量設定や記録に役立つ無料の計算ツールの一覧です。"
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}
>
  <div class="container container--narrow">
    <Breadcrumbs items={crumbs} />
    <h1>筋トレ計算ツール</h1>
    <ul class="tools">
      {
        tools.map((t) => (
          <li>
            <a href={t.href}>
              <span class="tools__title">{t.title}</span>
              <span class="tools__desc">{t.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .tools {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .tools a {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }
  .tools a:hover {
    border-color: var(--color-primary);
  }
  .tools__title {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
  }
  .tools__desc {
    display: block;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
</style>
