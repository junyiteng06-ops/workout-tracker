---
import Alert from '@/components/Alert.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { authErrorMessage } from '@/lib/authErrors';
import { formString, safeNext } from '@/lib/http';

export const prerender = false;

const MIN_PASSWORD = 8;
const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next);

let error = '';
let sent = false;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = formString(form, 'email');
  const password = String(form.get('password') ?? '');
  if (password.length < MIN_PASSWORD) {
    error = `パスワードは${MIN_PASSWORD}文字以上で入力してください。`;
  } else {
    const { data, error: authError } = await Astro.locals.supabase.auth.signUp({
      email,
      password,
      options: { emailRedirectTo: `${Astro.url.origin}/auth/callback?next=${encodeURIComponent(next)}` },
    });
    if (authError) error = authErrorMessage(authError);
    else if (data.session) return Astro.redirect(next, 303);
    else sent = true;
  }
}
---

<AuthLayout title="新規登録(無料)">
  {
    sent ? (
      <Alert
        type="success"
        message={`${email} に確認メールを送信しました。メール内のリンクを開くと登録が完了します。届かない場合は迷惑メールフォルダもご確認ください。`}
      />
    ) : (
      <>
        <Alert type="error" message={error} />
        <form method="post">
          <label>
            メールアドレス
            <input type="email" name="email" value={email} autocomplete="email" required />
          </label>
          <label>
            パスワード({MIN_PASSWORD}文字以上)
            <input type="password" name="password" autocomplete="new-password" minlength={MIN_PASSWORD} required />
          </label>
          <p class="auth__note">
            登録すると、<a href="/privacy">プライバシーポリシー</a>に同意したものとみなされます。
          </p>
          <button class="btn" type="submit">登録する</button>
        </form>
      </>
    )
  }
  <div class="auth__links">
    <p>すでにアカウントをお持ちの方は <a href="/login">ログイン</a></p>
  </div>
</AuthLayout>
