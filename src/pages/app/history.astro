---
import Alert from '@/components/Alert.astro';
import WorkoutSummary from '@/components/app/WorkoutSummary.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { WORKOUT_SELECT } from '@/lib/workouts';

export const prerender = false;

const PER_PAGE = 20;
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const from = (page - 1) * PER_PAGE;

const { data, count, error } = await Astro.locals.supabase
  .from('workouts')
  .select(WORKOUT_SELECT, { count: 'exact' })
  .order('performed_on', { ascending: false })
  .order('id', { ascending: false })
  .range(from, from + PER_PAGE - 1);

const workouts = data ?? [];
const totalPages = Math.max(1, Math.ceil((count ?? 0) / PER_PAGE));
const flash = Astro.url.searchParams.get('saved') ? '保存しました。' : Astro.url.searchParams.get('deleted') ? '削除しました。' : '';
---

<AppLayout title="トレーニング履歴">
  <Alert type="success" message={flash} />
  <Alert type="error" message={error ? 'データの読み込みに失敗しました。時間をおいて再読み込みしてください。' : ''} />
  {
    workouts.length > 0 ? (
      workouts.map((w) => <WorkoutSummary workout={w} />)
    ) : (
      <p class="empty">
        まだ記録がありません。<a href="/app/log/new">トレーニングを記録する</a>
      </p>
    )
  }
  {
    totalPages > 1 && (
      <nav class="pager" aria-label="ページ送り">
        {page > 1 ? <a href={`?page=${page - 1}`}>← 新しい記録</a> : <span />}
        <span class="muted">
          {page} / {totalPages}
        </span>
        {page < totalPages ? <a href={`?page=${page + 1}`}>古い記録 →</a> : <span />}
      </nav>
    )
  }
</AppLayout>

<style>
  .pager {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }
</style>
